{
  "name": "velora",
  "version": "1.2.3",
  "description": "this is a electron init",
  "author": "JY",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder --dir && node -e \"const fs=require('fs'); fs.rmSync('release/builder-effective-config.yaml', {force:true});\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.4",
    "electron-store": "^11.0.2",
    "hls.js": "^1.6.16",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^24.9.1",
    "less": "^4.6.7",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.0"
  },
  "build": {
    "appId": "com.velora.app",
    "productName": "Velora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "public"
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
